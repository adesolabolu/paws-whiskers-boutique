<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Hero Slider Logic
    const setupSlider = (containerId) => {
      const container = document.getElementById(containerId);
      if (!container) return;

      const images = container.querySelectorAll('img');
      let currentIndex = 0;

      setInterval(() => {
        images[currentIndex].classList.remove('opacity-100', 'z-10');
        images[currentIndex].classList.add('opacity-0', 'z-0');
        currentIndex = (currentIndex + 1) % images.length;
        images[currentIndex].classList.remove('opacity-0', 'z-0');
        images[currentIndex].classList.add('opacity-100', 'z-10');
      }, 5000);
    };

    setupSlider('hero-slider-left');
    setupSlider('hero-slider-right');

    // Parallax Effect
    const parallaxText = document.getElementById('parallax-text-container');
    if (parallaxText) {
      window.addEventListener('scroll', () => {
        const scrolled = window.pageYOffset;
        const parent = parallaxText.parentElement;
        const parentRect = parent.getBoundingClientRect();
        
        if (parentRect.top < window.innerHeight && parentRect.bottom > 0) {
          const relativeScroll = window.innerHeight / 2 - (parentRect.top + parentRect.height / 2);
          const movement = relativeScroll * 0.1;
          parallaxText.style.transform = `translateY(${movement}px)`;
        }
      });
    }

    // Journey Horizontal Scroll Logic
    const journeySection = document.getElementById('journey-section');
    const journeyTrack = journeySection?.querySelector('.journey-track');
    const scrollContainer = journeySection?.querySelector('.journey-scroll-container');

    if (journeyTrack && scrollContainer) {
      const updateJourneyScroll = () => {
        const rect = scrollContainer.getBoundingClientRect();
        const scrollStart = 0;
        const scrollEnd = scrollContainer.offsetHeight - window.innerHeight;
        
        // Calculate progress (0 to 1) based on sticky container position
        let progress = -rect.top / scrollEnd;
        progress = Math.max(0, Math.min(1, progress));

        const maxTranslate = journeyTrack.scrollWidth - window.innerWidth;
        journeyTrack.style.transform = `translateX(${-progress * maxTranslate}px)`;
      };

      window.addEventListener('scroll', updateJourneyScroll);
      window.addEventListener('resize', updateJourneyScroll);
    }

    // Anchor Link Smooth Scroll
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          window.scrollTo({
            top: target.offsetTop - 80,
            behavior: 'smooth'
          });
        }
      });
    });
  });
</script></main>


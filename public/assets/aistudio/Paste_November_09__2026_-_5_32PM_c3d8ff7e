  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Intersection Observer for scroll animations
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-on-scroll-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll('[data-animation-on-scroll]').forEach(el => {
        el.classList.add('animate-on-scroll-hidden');
        observer.observe(el);
      });

      // Navigation Logic
      const projectOverlay = document.getElementById('project-overlay');
      const navMenuBox = document.getElementById('nav-menu-box');
      const menuTrigger = document.getElementById('menu-trigger');
      const bar1 = document.getElementById('menu-bar-1');
      const bar2 = document.getElementById('menu-bar-2');
      const menuText1 = document.getElementById('menu-text-1');
      const menuText2 = document.getElementById('menu-text-2');

      let isMenuOpen = false;

      const toggleMenu = (e) => {
          if(e) e.stopPropagation();
          isMenuOpen = !isMenuOpen;
          
          if (isMenuOpen) {
              navMenuBox.classList.remove('opacity-0', 'translate-y-10', 'pointer-events-none');
              navMenuBox.classList.add('opacity-100', 'translate-y-0');
              bar1.style.transform = 'translateY(3.5px) rotate(45deg)';
              bar2.style.transform = 'translateY(-3.5px) rotate(-45deg)';
              if(menuText1) menuText1.textContent = 'Close';
              if(menuText2) menuText2.textContent = 'Back';
          } else {
              navMenuBox.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none');
              navMenuBox.classList.remove('opacity-100', 'translate-y-0');
              bar1.style.transform = 'none';
              bar2.style.transform = 'none';
              if(menuText1) menuText1.textContent = 'Menu';
              if(menuText2) menuText2.textContent = 'Explore';
          }
      };

      const openOverlay = () => {
          projectOverlay.classList.remove('translate-y-full');
          document.body.style.overflow = 'hidden';
          if(isMenuOpen) toggleMenu();
      };

      const closeOverlay = () => {
          projectOverlay.classList.add('translate-y-full');
          document.body.style.overflow = '';
      };

      document.addEventListener('click', (e) => {
          if (e.target.closest('[data-trigger="project-overlay"]')) {
              openOverlay();
          }
          if (e.target.closest('[data-close="project-overlay"]')) {
              closeOverlay();
          }
          if (e.target.closest('#menu-trigger')) {
              toggleMenu(e);
          } else if (isMenuOpen && !navMenuBox.contains(e.target)) {
              toggleMenu(e);
          }
      });

      window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
              if (!projectOverlay.classList.contains('translate-y-full')) closeOverlay();
              if (isMenuOpen) toggleMenu();
          }
      });
      
      // Smooth Scroll for anchor links inside the menu
      document.querySelectorAll('#nav-menu-box a[href^="#"], .max-w-\[1200px\] a[href^="#"]').forEach(anchor => {
          anchor.addEventListener('click', function (e) {
              e.preventDefault();
              if(isMenuOpen) toggleMenu();
              const target = document.querySelector(this.getAttribute('href'));
              if (target) {
                  window.scrollTo({
                      top: target.offsetTop - 80,
                      behavior: 'smooth'
                  });
              }
          });
      });
    });
  </script>

